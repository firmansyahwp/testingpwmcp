{
  "compilerOptions": {

    "target": "ES2020",

    "module": "commonjs",

    "types": ["node"],

    "esModuleInterop": true,

    "resolveJsonModule": true,

    "strict": false,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,
    "rootDir": "./"
  },

  "include": [
    "**/*.ts"
  ],

  "exclude": [
    "node_modules"
  ]
}